---
const appName = "Joe's Reading List";
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{appName}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X3VLQ2E9FZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X3VLQ2E9FZ');
    </script>
    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");

      :root {
        color-scheme: light;
        --bg: #ffffff;
        --ink: #1f2937;
        --muted: #6b7280;
        --line: #e5e7eb;
        --line-soft: #f1f5f9;
        --link: #0f4c81;
        --link-hover: #0c3b64;
      }

      body {
        margin: 0;
        background: var(--bg);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 44px 24px 56px;
      }

      .hero {
        margin-bottom: 22px;
      }

      h1 {
        margin: 0;
        font-size: clamp(1.7rem, 2.6vw, 2.1rem);
        line-height: 1.15;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .subtitle {
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.5;
        margin-top: 8px;
      }

      ul {
        list-style: none;
        padding: 0;
        margin: 0;
        border-top: 1px solid var(--line);
      }

      #link-list li {
        margin: 0;
        padding: 15px 0;
        border-bottom: 1px solid var(--line-soft);
      }

      .title {
        font-weight: 600;
        font-size: 1rem;
        line-height: 1.3;
      }

      a {
        color: var(--link);
        text-decoration: none;
      }

      a:hover {
        color: var(--link-hover);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .url {
        color: var(--muted);
        font-size: 0.82rem;
        line-height: 1.45;
        margin-top: 5px;
        word-break: break-all;
      }

      .meta {
        color: var(--muted);
        font-size: 0.77rem;
        margin-top: 7px;
      }

      footer {
        margin-top: 24px;
        padding-top: 15px;
        border-top: 1px solid var(--line);
      }

      footer a {
        color: var(--link);
        text-decoration: none;
      }

      .footer-inner {
        font-size: 0.82rem;
      }

      .footer-note {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--link-hover);
        text-decoration: underline;
      }

      @media (max-width: 640px) {
        main {
          padding: 24px 16px 34px;
        }

        .hero {
          margin-bottom: 18px;
        }

        h1 {
          font-size: 1.5rem;
        }

        #link-list li {
          padding: 14px 0;
        }

        footer {
          margin-top: 20px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header class="hero">
        <h1>{appName}</h1>
        <div class="subtitle">
          Technical articles I’ve read and liked.
        </div>
      </header>

      <ul id="link-list">
        <li>Loading...</li>
      </ul>

      <footer>
        <div class="footer-inner">
          <span class="footer-note">
            my own articles are <a href="https://www.joesluis.com/blog" target="_blank" rel="noreferrer">here</a>
          </span>
        </div>
      </footer>
    </main>

    <script type="module" define:vars={{ apiBase }}>
      const list = document.querySelector("#link-list");

      const renderLinks = (items) => {
        if (!items.length) {
          list.innerHTML = "<li>No links yet.</li>";
          return;
        }
        list.innerHTML = items
          .map((item) => {
            const url = item.url ?? item.URL ?? "";
            const title = item.title ?? "";
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            const displayTitle = title || url;
            const urlMarkup = title ? `<div class="url">${url}</div>` : "";
            return `
              <li>
                <div class="title">
                  <a href="${url}" target="_blank" rel="noreferrer">${displayTitle}</a>
                </div>
                ${urlMarkup}
                <div class="meta">${created}</div>
              </li>
            `;
          })
          .join("");
      };

      const loadLinks = async () => {
        const response = await fetch(`${apiBase}/links`);
        const data = await response.json();
        renderLinks(Array.isArray(data) ? data : []);
      };

      loadLinks();
    </script>
  </body>
</html>
