---
const appName = "Joe's Reading List";
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{appName}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X3VLQ2E9FZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X3VLQ2E9FZ');
    </script>
    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

      :root {
        color-scheme: light;
        --ink: #1f2937;
        --muted: #6b7280;
        --link: #3b82f6;
        --link-hover: #1d4ed8;
      }

      body {
        margin: 0;
        background: #fff;
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      main {
        max-width: 60ch;
        margin: 0 auto;
        padding: 48px 32px 60px;
        position: relative;
      }

      header {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 500;
      }

      .subtitle {
        color: #9ca3af;
        font-size: 0.75rem;
        max-width: 40ch;
      }

      .tab-bar {
        display: flex;
        gap: 8px;
        margin-top: 18px;
        flex-wrap: wrap;
        border-bottom: 1px solid #e5e7eb;
      }

      .tab-button {
        border: 0;
        border-bottom: 1px solid transparent;
        background: transparent;
        color: var(--muted);
        padding: 0 0 10px;
        margin-bottom: -1px;
        font: inherit;
        cursor: pointer;
      }

      .tab-button[aria-selected="true"] {
        color: var(--ink);
        border-bottom-color: #9ca3af;
      }

      ul {
        list-style: none;
        padding-left: 16px;
        margin: 20px 0 0;
        border-left: 1px solid #d1d5db;
      }

      #link-list li {
        margin: 6px 0;
        padding-left: 18px;
        position: relative;
      }

      #podcast-list li,
      #paper-list li,
      #link-list li {
        margin: 6px 0;
        padding-left: 18px;
        position: relative;
      }

      #podcast-list li::before,
      #paper-list li::before,
      #link-list li::before {
        content: ">";
        position: absolute;
        left: -2px;
        color: var(--muted);
      }

      .title {
        font-weight: 500;
      }

      a {
        color: var(--link);
        text-decoration: none;
      }

      a:hover {
        color: var(--link-hover);
        text-decoration: underline;
      }

      .url {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.35;
      }

      .meta {
        color: var(--muted);
        font-size: 0.85rem;
        margin-top: 2px;
      }

      .categories {
        margin-top: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .category-chip {
        border: 1px solid #d1d5db;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 0.75rem;
        color: var(--muted);
        background: #f9fafb;
      }

      .panel {
        display: none;
      }

      .panel.is-active {
        display: block;
      }

      footer {
        position: fixed;
        right: 24px;
        bottom: 20px;
        font-size: 0.75rem;
        color: var(--muted);
      }

      footer a {
        color: var(--muted);
        text-decoration: none;
        margin-right: 10px;
      }

      footer a:last-child {
        margin-right: 0;
      }

      .footer-inner {
        white-space: nowrap;
      }

      .footer-note {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--link-hover);
        text-decoration: underline;
      }

      @media (max-width: 640px) {
        footer {
          position: absolute;
          top: 12px;
          right: 12px;
          bottom: auto;
          margin-top: 0;
          text-align: right;
        }

        header {
          padding-top: 18px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>{appName}</h1>
        <div class="subtitle">
          Articles, papers, and podcasts I’ve read or listened to and liked.
        </div>
      </header>

      <div class="tab-bar" role="tablist" aria-label="Reading list sections">
        <button class="tab-button" id="tab-links" type="button" role="tab" aria-selected="true" aria-controls="panel-links">
          Articles (0)
        </button>
        <button class="tab-button" id="tab-papers" type="button" role="tab" aria-selected="false" aria-controls="panel-papers">
          Research Papers (0)
        </button>
        <button class="tab-button" id="tab-podcasts" type="button" role="tab" aria-selected="false" aria-controls="panel-podcasts">
          Podcasts (0)
        </button>
      </div>

      <section id="panel-links" class="panel is-active" role="tabpanel" aria-labelledby="tab-links">
        <ul id="link-list">
          <li>Loading...</li>
        </ul>
      </section>

      <section id="panel-papers" class="panel" role="tabpanel" aria-labelledby="tab-papers">
        <ul id="paper-list">
          <li>Loading...</li>
        </ul>
      </section>

      <section id="panel-podcasts" class="panel" role="tabpanel" aria-labelledby="tab-podcasts">
        <ul id="podcast-list">
          <li>Loading...</li>
        </ul>
      </section>

      <footer>
        <div class="footer-inner">
          <span class="footer-note">
            my own articles are <a href="https://www.joesluis.com/blog" target="_blank" rel="noreferrer">here :)</a>
          </span>
        </div>
      </footer>
    </main>

    <script type="module" define:vars={{ apiBase }}>
      const linkList = document.querySelector("#link-list");
      const paperList = document.querySelector("#paper-list");
      const podcastList = document.querySelector("#podcast-list");
      const linksTab = document.querySelector("#tab-links");
      const papersTab = document.querySelector("#tab-papers");
      const podcastsTab = document.querySelector("#tab-podcasts");
      const tabs = { links: linksTab, papers: papersTab, podcasts: podcastsTab };
      const panels = {
        links: document.querySelector("#panel-links"),
        papers: document.querySelector("#panel-papers"),
        podcasts: document.querySelector("#panel-podcasts"),
      };

      const setActiveTab = (tab) => {
        Object.entries(tabs).forEach(([name, button]) => {
          button.setAttribute("aria-selected", String(name === tab));
          panels[name].classList.toggle("is-active", name === tab);
        });
      };

      const renderLinks = (items) => {
        linksTab.textContent = `Articles (${items.length})`;
        if (!items.length) {
          linkList.innerHTML = "<li>No links yet.</li>";
          return;
        }
        linkList.innerHTML = items
          .map((item) => {
            const url = item.url ?? item.URL ?? "";
            const title = item.title ?? "";
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            const displayTitle = title || url;
            const urlMarkup = title ? `<div class="url">${url}</div>` : "";
            return `
              <li>
                <div class="title">
                  <a href="${url}" target="_blank" rel="noreferrer">${displayTitle}</a>
                </div>
                ${urlMarkup}
                <div class="meta">${created}</div>
              </li>
            `;
          })
          .join("");
      };

      const renderPapers = (items) => {
        papersTab.textContent = `Research Papers (${items.length})`;
        if (!items.length) {
          paperList.innerHTML = "<li>No research papers yet.</li>";
          return;
        }

        paperList.innerHTML = items
          .map((item) => {
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            const categories = Array.isArray(item.categories) ? item.categories : [];
            const categoryMarkup = categories.length
              ? `<div class="categories">${categories
                  .map((category) => `<span class="category-chip">${category}</span>`)
                  .join("")}</div>`
              : "";

            return `
              <li>
                <div class="title">
                  <a href="${item.url}" target="_blank" rel="noreferrer">${item.title}</a>
                </div>
                <div class="url">${item.url}</div>
                <div class="meta">${created}</div>
                ${categoryMarkup}
              </li>
            `;
          })
          .join("");
      };

      const renderPodcasts = (items) => {
        podcastsTab.textContent = `Podcasts (${items.length})`;
        if (!items.length) {
          podcastList.innerHTML = "<li>No podcasts yet.</li>";
          return;
        }

        podcastList.innerHTML = items
          .map((item) => {
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            return `
              <li>
                <div class="title">
                  <a href="${item.url}" target="_blank" rel="noreferrer">${item.title}</a>
                </div>
                <div class="url">${item.url}</div>
                <div class="meta">${created}</div>
              </li>
            `;
          })
          .join("");
      };

      const loadLinks = async () => {
        const response = await fetch(`${apiBase}/links`);
        const data = await response.json();
        renderLinks(Array.isArray(data) ? data : []);
      };

      const loadPapers = async () => {
        const response = await fetch(`${apiBase}/papers`);
        const data = await response.json();
        renderPapers(Array.isArray(data) ? data : []);
      };

      const loadPodcasts = async () => {
        const response = await fetch(`${apiBase}/podcasts`);
        const data = await response.json();
        renderPodcasts(Array.isArray(data) ? data : []);
      };

      linksTab.addEventListener("click", () => setActiveTab("links"));
      papersTab.addEventListener("click", () => setActiveTab("papers"));
      podcastsTab.addEventListener("click", () => setActiveTab("podcasts"));

      await Promise.all([loadLinks(), loadPapers(), loadPodcasts()]);
    </script>
  </body>
</html>
