---
const appName = "Joe's Reading List";
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{appName}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X3VLQ2E9FZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X3VLQ2E9FZ');
    </script>
    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

      :root {
        color-scheme: dark;
        --ink: #f5f5f5;
        --muted: #949494;
        --line: rgba(255, 255, 255, 0.18);
        --line-strong: rgba(255, 255, 255, 0.4);
        --cell: rgba(0, 0, 0, 0.82);
        --grid-size: 32px;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background-color: #050505;
        background-image:
          linear-gradient(var(--line) 1px, transparent 1px),
          linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: var(--grid-size) var(--grid-size);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 32px 48px;
        position: relative;
      }

      header {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 22px 24px;
        border: 1px solid var(--line-strong);
        background: var(--cell);
      }

      h1 {
        margin: 0;
        font-size: clamp(1.7rem, 4vw, 2.7rem);
        font-weight: 600;
        letter-spacing: -0.045em;
      }

      .subtitle {
        color: var(--muted);
        font-size: 0.8rem;
        max-width: none;
        padding-left: 8px;
        letter-spacing: 0.04em;
        text-transform: lowercase;
        white-space: nowrap;
      }

      .tab-bar {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 32px;
        border-top: 1px solid var(--line-strong);
        border-left: 1px solid var(--line-strong);
      }

      .tab-button {
        border: 0;
        border-right: 1px solid var(--line-strong);
        border-bottom: 1px solid var(--line-strong);
        background: transparent;
        color: var(--muted);
        padding: 14px 12px;
        font: inherit;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 120ms ease, color 120ms ease;
      }

      .tab-button[aria-selected="true"] {
        color: #050505;
        background: #f5f5f5;
      }

      .tab-button:hover:not([aria-selected="true"]) {
        color: var(--ink);
        background: rgba(255, 255, 255, 0.07);
      }

      ul {
        list-style: none;
        display: grid;
        grid-template-columns: 1fr;
        padding: 0;
        margin: 32px 0 0;
        border-top: 1px solid var(--line-strong);
        border-left: 1px solid var(--line-strong);
      }

      #podcast-list li,
      #paper-list li,
      #link-list li {
        box-sizing: border-box;
        min-width: 0;
        min-height: 128px;
        margin: 0;
        padding: 20px;
        border-right: 1px solid var(--line-strong);
        border-bottom: 1px solid var(--line-strong);
        background: var(--cell);
        transition: background 120ms ease;
      }

      #podcast-list li:hover,
      #paper-list li:hover,
      #link-list li:hover {
        background: rgba(22, 22, 22, 0.94);
      }

      .title {
        font-weight: 500;
        line-height: 1.45;
      }

      a {
        color: var(--ink);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
      }

      .meta {
        color: var(--muted);
        font-size: 0.7rem;
        margin-top: 12px;
        letter-spacing: 0.04em;
      }

      .categories {
        margin-top: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .category-chip {
        border: 1px solid var(--line-strong);
        padding: 3px 7px;
        font-size: 0.68rem;
        color: var(--muted);
        background: #050505;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .panel {
        display: none;
      }

      .panel.is-active {
        display: block;
      }

      footer {
        margin-top: 32px;
        padding: 14px 16px;
        border: 1px solid var(--line-strong);
        background: var(--cell);
        font-size: 0.75rem;
        color: var(--muted);
        text-align: right;
      }

      footer a {
        color: var(--ink);
        text-decoration: none;
        margin-right: 10px;
      }

      footer a:last-child {
        margin-right: 0;
      }

      .footer-inner {
        white-space: nowrap;
      }

      .footer-note {
        color: var(--muted);
      }

      footer a:hover {
        text-decoration: underline;
      }

      @media (max-width: 640px) {
        main {
          padding: 32px 16px;
        }

        .subtitle {
          font-size: clamp(0.5rem, 2.4vw, 0.8rem);
          letter-spacing: 0.01em;
        }

        .tab-bar {
          grid-template-columns: 1fr;
        }

        #podcast-list li,
        #paper-list li,
        #link-list li {
          min-height: 112px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>{appName}</h1>
        <div class="subtitle">
          not just a reading list anymore, but you get the idea
        </div>
      </header>

      <div class="tab-bar" role="tablist" aria-label="Reading list sections">
        <button class="tab-button" id="tab-links" type="button" role="tab" aria-selected="true" aria-controls="panel-links">
          Articles (0)
        </button>
        <button class="tab-button" id="tab-papers" type="button" role="tab" aria-selected="false" aria-controls="panel-papers">
          Research Papers (0)
        </button>
        <button class="tab-button" id="tab-podcasts" type="button" role="tab" aria-selected="false" aria-controls="panel-podcasts">
          Podcasts (0)
        </button>
      </div>

      <section id="panel-links" class="panel is-active" role="tabpanel" aria-labelledby="tab-links">
        <ul id="link-list">
          <li>Loading...</li>
        </ul>
      </section>

      <section id="panel-papers" class="panel" role="tabpanel" aria-labelledby="tab-papers">
        <ul id="paper-list">
          <li>Loading...</li>
        </ul>
      </section>

      <section id="panel-podcasts" class="panel" role="tabpanel" aria-labelledby="tab-podcasts">
        <ul id="podcast-list">
          <li>Loading...</li>
        </ul>
      </section>

      <footer>
        <div class="footer-inner">
          <span class="footer-note">
            my own articles are <a href="https://www.joesluis.com/blog" target="_blank" rel="noreferrer">here :)</a>
          </span>
        </div>
      </footer>
    </main>

    <script type="module" define:vars={{ apiBase }}>
      const linkList = document.querySelector("#link-list");
      const paperList = document.querySelector("#paper-list");
      const podcastList = document.querySelector("#podcast-list");
      const linksTab = document.querySelector("#tab-links");
      const papersTab = document.querySelector("#tab-papers");
      const podcastsTab = document.querySelector("#tab-podcasts");
      const tabs = { links: linksTab, papers: papersTab, podcasts: podcastsTab };
      const panels = {
        links: document.querySelector("#panel-links"),
        papers: document.querySelector("#panel-papers"),
        podcasts: document.querySelector("#panel-podcasts"),
      };

      const setActiveTab = (tab) => {
        Object.entries(tabs).forEach(([name, button]) => {
          button.setAttribute("aria-selected", String(name === tab));
          panels[name].classList.toggle("is-active", name === tab);
        });
      };

      const renderLinks = (items) => {
        linksTab.textContent = `Articles (${items.length})`;
        if (!items.length) {
          linkList.innerHTML = "<li>No links yet.</li>";
          return;
        }
        linkList.innerHTML = items
          .map((item) => {
            const url = item.url ?? item.URL ?? "";
            const title = item.title ?? "";
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            const displayTitle = title || url;
            return `
              <li>
                <div class="title">
                  <a href="${url}" target="_blank" rel="noreferrer">${displayTitle}</a>
                </div>
                <div class="meta">${created}</div>
              </li>
            `;
          })
          .join("");
      };

      const renderPapers = (items) => {
        papersTab.textContent = `Research Papers (${items.length})`;
        if (!items.length) {
          paperList.innerHTML = "<li>No research papers yet.</li>";
          return;
        }

        paperList.innerHTML = items
          .map((item) => {
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            const categories = Array.isArray(item.categories) ? item.categories : [];
            const categoryMarkup = categories.length
              ? `<div class="categories">${categories
                  .map((category) => `<span class="category-chip">${category}</span>`)
                  .join("")}</div>`
              : "";

            return `
              <li>
                <div class="title">
                  <a href="${item.url}" target="_blank" rel="noreferrer">${item.title}</a>
                </div>
                <div class="meta">${created}</div>
                ${categoryMarkup}
              </li>
            `;
          })
          .join("");
      };

      const renderPodcasts = (items) => {
        podcastsTab.textContent = `Podcasts (${items.length})`;
        if (!items.length) {
          podcastList.innerHTML = "<li>No podcasts yet.</li>";
          return;
        }

        podcastList.innerHTML = items
          .map((item) => {
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            return `
              <li>
                <div class="title">
                  <a href="${item.url}" target="_blank" rel="noreferrer">${item.title}</a>
                </div>
                <div class="meta">${created}</div>
              </li>
            `;
          })
          .join("");
      };

      const loadLinks = async () => {
        const response = await fetch(`${apiBase}/links`);
        const data = await response.json();
        renderLinks(Array.isArray(data) ? data : []);
      };

      const loadPapers = async () => {
        const response = await fetch(`${apiBase}/papers`);
        const data = await response.json();
        renderPapers(Array.isArray(data) ? data : []);
      };

      const loadPodcasts = async () => {
        const response = await fetch(`${apiBase}/podcasts`);
        const data = await response.json();
        renderPodcasts(Array.isArray(data) ? data : []);
      };

      linksTab.addEventListener("click", () => setActiveTab("links"));
      papersTab.addEventListener("click", () => setActiveTab("papers"));
      podcastsTab.addEventListener("click", () => setActiveTab("podcasts"));

      await Promise.all([loadLinks(), loadPapers(), loadPodcasts()]);
    </script>
  </body>
</html>
