---
const appName = "Joe's Reading List";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{appName}</title>
    <style is:global>
      :root {
        color-scheme: light;
        --ink: #111;
        --muted: #555;
        --link: #0000ee;
        --border: #c7c7c7;
      }

      body {
        margin: 0;
        background: #fff;
        font-family: "Times New Roman", Times, serif;
        color: var(--ink);
      }

      main {
        max-width: 760px;
        margin: 28px auto 60px;
        padding: 0 18px;
      }

      header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
        padding-bottom: 10px;
      }

      h1 {
        margin: 0;
        font-size: 28px;
      }

      nav a {
        color: var(--link);
        text-decoration: none;
        margin-left: 12px;
      }

      nav a:hover {
        text-decoration: underline;
      }

      ul {
        list-style: none;
        padding: 0;
        margin: 18px 0 0;
      }

      #link-list li {
        padding: 12px 0 18px;
        margin-bottom: 16px;
        border-bottom: 1px solid #cfcfcf;
        box-shadow: inset 0 -2px 0 #f0f0f0;
      }

      .title {
        font-weight: 700;
        margin-bottom: 6px;
      }

      a {
        color: var(--link);
      }

      .meta {
        color: var(--muted);
        font-size: 12px;
        margin-top: 6px;
      }

      .row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: baseline;
        flex-wrap: wrap;
        margin-bottom: 6px;
      }

      button {
        border: 1px solid var(--border);
        background: #f2f2f2;
        padding: 2px 8px;
        cursor: pointer;
        font-size: 13px;
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>{appName}</h1>
        <nav>
          <a href="/add">Add link</a>
        </nav>
      </header>

      <ul id="link-list">
        <li>Loading...</li>
      </ul>
    </main>

    <script type="module">
      const list = document.querySelector("#link-list");
      const apiBase = "http://localhost:8787";

      const renderLinks = (items) => {
        if (!items.length) {
          list.innerHTML = "<li>No links yet.</li>";
          return;
        }
        list.innerHTML = items
          .map((item) => {
            const url = item.url ?? item.URL ?? "";
            const title = item.title ?? "";
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            const titleMarkup = title ? `<div class="title">${title}</div>` : "";
            return `
              <li>
                ${titleMarkup}
                <div class="row">
                  <a href="${url}" target="_blank" rel="noreferrer">${url}</a>
                  <button data-id="${item.id}">Delete</button>
                </div>
                <div class="meta">${created}</div>
              </li>
            `;
          })
          .join("");
      };

      const loadLinks = async () => {
        const response = await fetch(`${apiBase}/links`);
        const data = await response.json();
        renderLinks(Array.isArray(data) ? data : []);
      };

      list.addEventListener("click", async (event) => {
        const button = event.target.closest("button[data-id]");
        if (!button) return;
        const id = button.dataset.id;
        await fetch(`${apiBase}/link/${id}`, { method: "DELETE" });
        await loadLinks();
      });

      loadLinks();
    </script>
  </body>
</html>
