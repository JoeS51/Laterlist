---
const appName = "Joe's Reading List";
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{appName}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X3VLQ2E9FZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X3VLQ2E9FZ');
    </script>
    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

      :root {
        color-scheme: light;
        --ink: #1f2937;
        --muted: #6b7280;
        --link: #3b82f6;
        --link-hover: #1d4ed8;
      }

      body {
        margin: 0;
        background: #fff;
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      main {
        max-width: 60ch;
        margin: 0 auto;
        padding: 48px 32px 60px;
      }

      header {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 500;
      }

      .subtitle {
        color: #9ca3af;
        font-size: 0.75rem;
        max-width: 40ch;
      }

      ul {
        list-style: none;
        padding-left: 16px;
        margin: 20px 0 0;
        border-left: 1px solid #d1d5db;
      }

      #link-list li {
        margin: 6px 0;
        padding-left: 18px;
        position: relative;
      }

      #link-list li::before {
        content: ">";
        position: absolute;
        left: -2px;
        color: var(--muted);
      }

      .title {
        font-weight: 500;
      }

      a {
        color: var(--link);
        text-decoration: none;
      }

      a:hover {
        color: var(--link-hover);
        text-decoration: underline;
      }

      .url {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.35;
      }

      .meta {
        color: var(--muted);
        font-size: 0.85rem;
        margin-top: 2px;
      }

      footer {
        position: fixed;
        right: 24px;
        bottom: 20px;
        font-size: 0.75rem;
        color: var(--muted);
      }

      footer a {
        color: var(--muted);
        text-decoration: none;
        margin-right: 10px;
      }

      footer a:last-child {
        margin-right: 0;
      }

      .footer-inner {
        white-space: nowrap;
      }

      .footer-note {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--link-hover);
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>{appName}</h1>
        <div class="subtitle">
          Technical articles I’ve read and liked.
        </div>
      </header>

      <ul id="link-list">
        <li>Loading...</li>
      </ul>
    </main>

    <footer>
      <div class="footer-inner">
        <span class="footer-note">
          my own articles are <a href="https://www.joesluis.com/blog" target="_blank" rel="noreferrer">here :)</a>
        </span>
      </div>
    </footer>

    <script type="module" define:vars={{ apiBase }}>
      const list = document.querySelector("#link-list");

      const renderLinks = (items) => {
        if (!items.length) {
          list.innerHTML = "<li>No links yet.</li>";
          return;
        }
        list.innerHTML = items
          .map((item) => {
            const url = item.url ?? item.URL ?? "";
            const title = item.title ?? "";
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            const displayTitle = title || url;
            const urlMarkup = title ? `<div class="url">${url}</div>` : "";
            return `
              <li>
                <div class="title">
                  <a href="${url}" target="_blank" rel="noreferrer">${displayTitle}</a>
                </div>
                ${urlMarkup}
                <div class="meta">${created}</div>
              </li>
            `;
          })
          .join("");
      };

      const loadLinks = async () => {
        const response = await fetch(`${apiBase}/links`);
        const data = await response.json();
        renderLinks(Array.isArray(data) ? data : []);
      };

      loadLinks();
    </script>
  </body>
</html>
