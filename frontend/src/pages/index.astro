---
const appName = "Joe's Reading List";
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{appName}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X3VLQ2E9FZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X3VLQ2E9FZ');
    </script>
    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500&display=swap");

      :root {
        color-scheme: light;
        --bg: #f3f1ec;
        --surface: rgba(255, 255, 255, 0.88);
        --surface-strong: #ffffff;
        --ink: #1f2328;
        --muted: #667085;
        --line: rgba(15, 23, 42, 0.1);
        --link: #0f766e;
        --link-hover: #115e59;
        --shadow: 0 20px 60px rgba(16, 24, 40, 0.08);
        --radius: 18px;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 12% 8%, rgba(15, 118, 110, 0.08), transparent 45%),
          radial-gradient(circle at 92% 12%, rgba(180, 83, 9, 0.08), transparent 42%),
          var(--bg);
        font-family: "Manrope", system-ui, -apple-system, sans-serif;
        color: var(--ink);
        letter-spacing: -0.015em;
      }

      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 32px 20px 48px;
      }

      .shell {
        background: var(--surface);
        border: 1px solid rgba(255, 255, 255, 0.75);
        box-shadow: var(--shadow);
        border-radius: 28px;
        backdrop-filter: blur(10px);
        overflow: hidden;
      }

      .hero {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 28px 28px 18px;
        border-bottom: 1px solid var(--line);
        flex-wrap: wrap;
      }

      .hero-copy {
        display: grid;
        gap: 6px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #0f766e;
      }

      .eyebrow::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: currentColor;
      }

      h1 {
        margin: 0;
        font-family: "Newsreader", Georgia, serif;
        font-size: clamp(2rem, 4vw, 2.6rem);
        line-height: 1.02;
        font-weight: 500;
        letter-spacing: -0.03em;
      }

      .subtitle {
        color: var(--muted);
        font-size: 0.95rem;
        max-width: 46ch;
        line-height: 1.45;
      }

      .hero-note {
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 8px 12px;
        font-size: 0.82rem;
        color: var(--muted);
        white-space: nowrap;
      }

      ul {
        list-style: none;
        padding: 14px;
        margin: 0;
        display: grid;
        gap: 10px;
      }

      #link-list li {
        margin: 0;
        padding: 14px 14px 13px;
        border-radius: 14px;
        border: 1px solid transparent;
        background: rgba(255, 255, 255, 0.72);
        transition: border-color 120ms ease, transform 120ms ease, background-color 120ms ease;
      }

      #link-list li:hover {
        border-color: rgba(15, 118, 110, 0.18);
        background: var(--surface-strong);
        transform: translateY(-1px);
      }

      .title {
        font-weight: 700;
        line-height: 1.3;
      }

      a {
        color: var(--link);
        text-decoration: none;
      }

      a:hover {
        color: var(--link-hover);
        text-decoration: none;
      }

      .url {
        color: var(--muted);
        font-size: 0.85rem;
        line-height: 1.4;
        margin-top: 4px;
        word-break: break-all;
      }

      .meta {
        color: var(--muted);
        font-size: 0.8rem;
        margin-top: 8px;
      }

      footer {
        padding: 0 28px 22px;
      }

      footer a {
        color: var(--link);
        text-decoration: none;
      }

      .footer-inner {
        border-top: 1px solid var(--line);
        padding-top: 16px;
        font-size: 0.84rem;
      }

      .footer-note {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--link-hover);
        text-decoration: none;
      }

      @media (max-width: 640px) {
        main {
          padding: 16px 12px 28px;
        }

        .shell {
          border-radius: 20px;
        }

        .hero {
          padding: 20px 18px 14px;
        }

        ul {
          padding: 10px;
          gap: 8px;
        }

        #link-list li {
          padding: 12px;
        }

        footer {
          padding: 0 18px 18px;
        }

        .hero-note {
          white-space: normal;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="shell">
        <header class="hero">
          <div class="hero-copy">
            <div class="eyebrow">Reading List</div>
            <h1>{appName}</h1>
            <div class="subtitle">
              Technical articles I’ve read and liked.
            </div>
          </div>
          <div class="hero-note">
            Curated links, nothing noisy.
          </div>
        </header>

        <ul id="link-list">
          <li>Loading...</li>
        </ul>

        <footer>
          <div class="footer-inner">
            <span class="footer-note">
              my own articles are <a href="https://www.joesluis.com/blog" target="_blank" rel="noreferrer">here</a>
            </span>
          </div>
        </footer>
      </section>
    </main>

    <script type="module" define:vars={{ apiBase }}>
      const list = document.querySelector("#link-list");

      const renderLinks = (items) => {
        if (!items.length) {
          list.innerHTML = "<li>No links yet.</li>";
          return;
        }
        list.innerHTML = items
          .map((item) => {
            const url = item.url ?? item.URL ?? "";
            const title = item.title ?? "";
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            const displayTitle = title || url;
            const urlMarkup = title ? `<div class="url">${url}</div>` : "";
            return `
              <li>
                <div class="title">
                  <a href="${url}" target="_blank" rel="noreferrer">${displayTitle}</a>
                </div>
                ${urlMarkup}
                <div class="meta">${created}</div>
              </li>
            `;
          })
          .join("");
      };

      const loadLinks = async () => {
        const response = await fetch(`${apiBase}/links`);
        const data = await response.json();
        renderLinks(Array.isArray(data) ? data : []);
      };

      loadLinks();
    </script>
  </body>
</html>
