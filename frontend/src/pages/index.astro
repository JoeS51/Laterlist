---
const appName = "Joe's Reading List";
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{appName}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X3VLQ2E9FZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X3VLQ2E9FZ');
    </script>
    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

      :root {
        color-scheme: dark;
        --ink: #f5f5f5;
        --muted: #949494;
        --line: rgba(255, 255, 255, 0.07);
        --line-strong: rgba(255, 255, 255, 0.28);
        --cell: rgba(0, 0, 0, 0.84);
        --grid-size: 20px;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background-color: #050505;
        background-image:
          linear-gradient(var(--line) 1px, transparent 1px),
          linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: var(--grid-size) var(--grid-size);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      :focus-visible {
        outline: 1px solid var(--ink);
        outline-offset: 2px;
      }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 32px 48px;
        position: relative;
      }

      header {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 22px 24px;
        border: 1px solid var(--line-strong);
        background: var(--cell);
      }

      h1 {
        margin: 0;
        font-size: clamp(1.7rem, 4vw, 2.7rem);
        font-weight: 600;
        letter-spacing: -0.045em;
      }

      .tab-bar {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 32px;
        border-top: 1px solid var(--line-strong);
        border-left: 1px solid var(--line-strong);
      }

      .tab-button {
        border: 0;
        border-right: 1px solid var(--line-strong);
        border-bottom: 1px solid var(--line-strong);
        background: var(--cell);
        color: var(--muted);
        padding: 14px 12px;
        font: inherit;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 120ms ease, color 120ms ease;
      }

      .tab-button[aria-selected="true"] {
        color: #050505;
        background: var(--ink);
      }

      .tab-button:hover:not([aria-selected="true"]) {
        color: var(--ink);
        background: rgba(30, 30, 30, 0.94);
      }

      .tab-button:focus-visible {
        outline-offset: -4px;
      }

      .tab-button[aria-selected="true"]:focus-visible {
        outline-color: #050505;
      }

      .search {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 16px;
        border: 1px solid var(--line-strong);
        border-top: 0;
        background: var(--cell);
      }

      .search:focus-within {
        background: rgba(22, 22, 22, 0.94);
      }

      .search-icon {
        flex: none;
        color: var(--muted);
      }

      .search input {
        flex: 1;
        min-width: 0;
        padding: 14px 0;
        border: 0;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: 0.9rem;
        outline: none;
      }

      .search input::placeholder {
        color: var(--muted);
      }

      .search kbd {
        flex: none;
        border: 1px solid var(--line-strong);
        padding: 1px 6px;
        font: inherit;
        font-size: 0.7rem;
        color: var(--muted);
      }

      .search:focus-within kbd {
        display: none;
      }

      .category-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 16px;
      }

      .category-filter:empty {
        display: none;
      }

      ul {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
        padding: 0;
        margin: 16px 0 0;
        border-top: 1px solid var(--line-strong);
        border-left: 1px solid var(--line-strong);
      }

      .panel li {
        box-sizing: border-box;
        min-width: 0;
        margin: 0;
        padding: 16px 18px;
        border-right: 1px solid var(--line-strong);
        border-bottom: 1px solid var(--line-strong);
        background: var(--cell);
        transition: background 120ms ease;
      }

      .panel li.item:hover {
        background: rgba(22, 22, 22, 0.94);
      }

      .panel li.status {
        grid-column: 1 / -1;
        color: var(--muted);
        font-size: 0.85rem;
      }

      .title {
        font-weight: 500;
        line-height: 1.45;
        overflow-wrap: anywhere;
      }

      a {
        color: var(--ink);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
      }

      .meta {
        color: var(--muted);
        font-size: 0.75rem;
        margin-top: 8px;
        letter-spacing: 0.02em;
      }

      .categories {
        margin-top: 10px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .category-chip {
        border: 1px solid var(--line-strong);
        padding: 3px 7px;
        font: inherit;
        font-size: 0.72rem;
        color: var(--muted);
        background: #050505;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 120ms ease, color 120ms ease;
      }

      .category-chip:hover {
        color: var(--ink);
      }

      .category-chip[aria-pressed="true"] {
        color: #050505;
        background: var(--ink);
        border-color: var(--ink);
      }

      .retry {
        margin-left: 8px;
        border: 1px solid var(--line-strong);
        padding: 3px 8px;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: 0.75rem;
        cursor: pointer;
      }

      .skeleton-bar {
        height: 12px;
        background: rgba(255, 255, 255, 0.08);
        animation: pulse 1.2s ease-in-out infinite;
      }

      .skeleton-bar + .skeleton-bar {
        margin-top: 12px;
        height: 9px;
        width: 40%;
      }

      @keyframes pulse {
        50% {
          opacity: 0.4;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .skeleton-bar {
          animation: none;
        }
      }

      .panel {
        display: none;
      }

      .panel.is-active {
        display: block;
      }

      footer {
        margin-top: 32px;
        padding: 14px 16px;
        border: 1px solid var(--line-strong);
        background: var(--cell);
        font-size: 0.75rem;
        color: var(--muted);
        text-align: right;
      }

      footer a:hover {
        text-decoration: underline;
      }

      @media (max-width: 640px) {
        main {
          padding: 32px 16px;
        }

        .tab-button {
          padding: 12px 6px;
          font-size: 0.72rem;
          letter-spacing: 0.04em;
        }

        .tab-long {
          display: none;
        }

        .search kbd {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>{appName}</h1>
      </header>

      <div class="tab-bar" role="tablist" aria-label="Reading list sections">
        <button class="tab-button" id="tab-articles" type="button" role="tab" aria-selected="true" aria-controls="panel-articles">
          Articles <span class="count"></span>
        </button>
        <button class="tab-button" id="tab-papers" type="button" role="tab" aria-selected="false" aria-controls="panel-papers" tabindex="-1">
          <span class="tab-long">Research </span>Papers <span class="count"></span>
        </button>
        <button class="tab-button" id="tab-podcasts" type="button" role="tab" aria-selected="false" aria-controls="panel-podcasts" tabindex="-1">
          Podcasts <span class="count"></span>
        </button>
      </div>

      <label class="search">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5.25" stroke="currentColor" stroke-width="1.5" />
          <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
        <input id="search" type="search" placeholder="Search titles and sites" autocomplete="off" aria-label="Search" />
        <kbd>/</kbd>
      </label>

      <section id="panel-articles" class="panel is-active" role="tabpanel" aria-labelledby="tab-articles">
        <ul id="articles-list"></ul>
      </section>

      <section id="panel-papers" class="panel" role="tabpanel" aria-labelledby="tab-papers">
        <div class="category-filter" id="category-filter" role="group" aria-label="Filter by category"></div>
        <ul id="papers-list"></ul>
      </section>

      <section id="panel-podcasts" class="panel" role="tabpanel" aria-labelledby="tab-podcasts">
        <ul id="podcasts-list"></ul>
      </section>

      <footer>
        <a href="/stats">monthly stats</a> · my own articles are <a href="https://www.joesluis.com/blog" target="_blank" rel="noreferrer">here :)</a>
      </footer>
    </main>

    <script type="module" define:vars={{ apiBase }}>
      const sections = {
        articles: { endpoint: "/links", noun: "articles" },
        papers: { endpoint: "/papers", noun: "research papers" },
        podcasts: { endpoint: "/podcasts", noun: "podcasts" },
      };
      const tabNames = Object.keys(sections);

      for (const [name, section] of Object.entries(sections)) {
        section.tab = document.querySelector(`#tab-${name}`);
        section.panel = document.querySelector(`#panel-${name}`);
        section.list = document.querySelector(`#${name}-list`);
        section.count = section.tab.querySelector(".count");
        section.items = null;
        section.error = false;
      }

      const searchInput = document.querySelector("#search");
      const categoryFilter = document.querySelector("#category-filter");
      let query = "";
      let activeCategory = null;

      const escapeHtml = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (ch) => ({
          "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
        })[ch]);

      const hostOf = (url) => {
        try {
          return new URL(url).hostname.replace(/^www\./, "");
        } catch {
          return "";
        }
      };

      const formatDate = (timestamp) =>
        timestamp
          ? new Date(timestamp).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" })
          : "";

      const normalize = (item) => {
        const url = item.url ?? item.URL ?? "";
        const safeUrl = /^https?:\/\//i.test(url) ? url : "#";
        const host = hostOf(url);
        const title = item.title || url;
        const categories = Array.isArray(item.categories) ? item.categories : [];
        return {
          url: safeUrl,
          title,
          host,
          date: formatDate(item.created_at),
          categories,
          haystack: [title, host, ...categories].join(" ").toLowerCase(),
        };
      };

      const skeletonMarkup = Array.from({ length: 4 }, () =>
        `<li aria-hidden="true"><div class="skeleton-bar"></div><div class="skeleton-bar"></div></li>`
      ).join("");

      const itemMarkup = (item) => {
        const meta = [item.host, item.date].filter(Boolean).map(escapeHtml).join(" · ");
        const categories = item.categories.length
          ? `<div class="categories">${item.categories
              .map((category) => `<button type="button" class="category-chip" data-category="${escapeHtml(category)}" aria-pressed="${category === activeCategory}">${escapeHtml(category)}</button>`)
              .join("")}</div>`
          : "";
        return `
          <li class="item">
            <div class="title">
              <a href="${escapeHtml(item.url)}" target="_blank" rel="noreferrer">${escapeHtml(item.title)}</a>
            </div>
            <div class="meta">${meta}</div>
            ${categories}
          </li>
        `;
      };

      const visibleItems = (name) => {
        const { items } = sections[name];
        if (!items) return [];
        return items.filter((item) =>
          (!query || item.haystack.includes(query)) &&
          (name !== "papers" || !activeCategory || item.categories.includes(activeCategory))
        );
      };

      const renderSection = (name) => {
        const section = sections[name];

        if (section.error) {
          section.count.textContent = "";
          section.list.innerHTML = `<li class="status">Couldn't load ${section.noun}.<button type="button" class="retry" data-retry="${name}">Retry</button></li>`;
          return;
        }
        if (!section.items) {
          section.count.textContent = "";
          section.list.innerHTML = skeletonMarkup;
          return;
        }

        const visible = visibleItems(name);
        section.count.textContent = `(${visible.length})`;

        if (!section.items.length) {
          section.list.innerHTML = `<li class="status">No ${section.noun} yet.</li>`;
        } else if (!visible.length) {
          section.list.innerHTML = `<li class="status">No ${section.noun} match your filters.</li>`;
        } else {
          section.list.innerHTML = visible.map(itemMarkup).join("");
        }
      };

      const renderCategoryFilter = () => {
        const papers = sections.papers.items ?? [];
        const counts = new Map();
        for (const paper of papers) {
          for (const category of paper.categories) {
            counts.set(category, (counts.get(category) ?? 0) + 1);
          }
        }
        if (!counts.size) {
          categoryFilter.innerHTML = "";
          return;
        }
        const chip = (category, label) =>
          `<button type="button" class="category-chip" data-category="${escapeHtml(category ?? "")}" aria-pressed="${category === activeCategory}">${escapeHtml(label)}</button>`;
        categoryFilter.innerHTML = [
          chip(null, "All"),
          ...[...counts.keys()].sort().map((category) => chip(category, `${category} ${counts.get(category)}`)),
        ].join("");
      };

      const renderAll = () => {
        tabNames.forEach(renderSection);
        renderCategoryFilter();
      };

      const load = async (name) => {
        const section = sections[name];
        section.error = false;
        section.items = null;
        renderSection(name);
        try {
          const response = await fetch(`${apiBase}${section.endpoint}`);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          section.items = (Array.isArray(data) ? data : []).map(normalize);
        } catch (err) {
          console.error(`Failed to load ${name}`, err);
          section.error = true;
        }
        renderSection(name);
        if (name === "papers") renderCategoryFilter();
      };

      const setActiveTab = (name, { focus = false, updateHash = true } = {}) => {
        for (const [tabName, section] of Object.entries(sections)) {
          const selected = tabName === name;
          section.tab.setAttribute("aria-selected", String(selected));
          section.tab.tabIndex = selected ? 0 : -1;
          section.panel.classList.toggle("is-active", selected);
        }
        if (focus) sections[name].tab.focus();
        if (updateHash) history.replaceState(null, "", `#${name}`);
      };

      const tabFromHash = () => {
        const name = location.hash.slice(1);
        return sections[name] ? name : "articles";
      };

      for (const name of tabNames) {
        sections[name].tab.addEventListener("click", () => setActiveTab(name));
      }

      document.querySelector(".tab-bar").addEventListener("keydown", (event) => {
        const current = tabNames.findIndex((name) => sections[name].tab === document.activeElement);
        if (current === -1) return;
        const next = {
          ArrowRight: (current + 1) % tabNames.length,
          ArrowLeft: (current - 1 + tabNames.length) % tabNames.length,
          Home: 0,
          End: tabNames.length - 1,
        }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        setActiveTab(tabNames[next], { focus: true });
      });

      window.addEventListener("hashchange", () => setActiveTab(tabFromHash(), { updateHash: false }));

      searchInput.addEventListener("input", () => {
        query = searchInput.value.trim().toLowerCase();
        tabNames.forEach(renderSection);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "/" && document.activeElement !== searchInput && !event.target.closest("input, textarea")) {
          event.preventDefault();
          searchInput.focus();
        } else if (event.key === "Escape" && document.activeElement === searchInput && searchInput.value) {
          searchInput.value = "";
          query = "";
          tabNames.forEach(renderSection);
        }
      });

      document.addEventListener("click", (event) => {
        const chip = event.target.closest(".category-chip");
        if (chip) {
          const category = chip.dataset.category || null;
          activeCategory = category === activeCategory ? null : category;
          renderSection("papers");
          renderCategoryFilter();
          return;
        }
        const retry = event.target.closest("[data-retry]");
        if (retry) load(retry.dataset.retry);
      });

      setActiveTab(tabFromHash(), { updateHash: false });
      renderAll();
      await Promise.all(tabNames.map(load));
    </script>
  </body>
</html>
