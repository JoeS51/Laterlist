---
const appName = "Laterlist Admin";
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{appName}</title>
    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");

      :root {
        color-scheme: light;
        --bg: #fff;
        --ink: #1f2937;
        --muted: #6b7280;
        --line: #e5e7eb;
        --line-soft: #f1f5f9;
        --link: #0f4c81;
        --link-hover: #0c3b64;
        --btn: #1f2937;
        --btn-hover: #111827;
        --danger: #b42318;
      }

      body {
        margin: 0;
        background: var(--bg);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 42px 24px 56px;
      }

      header {
        margin-bottom: 18px;
      }

      h1 {
        margin: 0;
        font-size: clamp(1.65rem, 2.4vw, 2rem);
        line-height: 1.15;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .note {
        font-size: 0.9rem;
        color: var(--muted);
        line-height: 1.45;
        margin-top: 8px;
      }

      .auth {
        margin: 0 0 16px;
      }

      .auth-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
      }

      .field-group {
        display: grid;
        gap: 6px;
        flex: 1 1 280px;
      }

      label {
        font-weight: 600;
        font-size: 0.82rem;
        color: #374151;
      }

      input[type="password"],
      input[type="url"],
      input[type="text"] {
        width: 100%;
        min-height: 44px;
        box-sizing: border-box;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        background: #fff;
        color: var(--ink);
        font: inherit;
      }

      input:focus {
        outline: none;
        border-color: #9ca3af;
        box-shadow: 0 0 0 3px rgba(156, 163, 175, 0.2);
      }

      button {
        border: 1px solid var(--btn);
        background: var(--btn);
        color: #fff;
        padding: 10px 14px;
        min-height: 44px;
        border-radius: 8px;
        cursor: pointer;
        font: inherit;
        font-weight: 600;
        font-size: 0.9rem;
        transition: background-color 120ms ease, border-color 120ms ease;
      }

      button:hover {
        background: var(--btn-hover);
        border-color: var(--btn-hover);
      }

      .button-secondary {
        background: #fff;
        color: var(--ink);
        border-color: #d1d5db;
      }

      .button-secondary:hover {
        background: #f9fafb;
      }

      .button-danger {
        background: #fff;
        color: var(--danger);
        border-color: #fecaca;
        min-height: 32px;
        padding: 5px 10px;
        border-radius: 7px;
        font-size: 0.82rem;
      }

      .button-danger:hover {
        background: #fff5f5;
      }

      #admin-ui {
        margin-top: 4px;
      }

      form {
        margin: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) auto;
        gap: 12px;
        align-items: end;
        padding: 14px 0 18px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .field {
        display: grid;
        gap: 6px;
      }

      .status {
        margin-top: 10px;
        min-height: 18px;
        color: var(--muted);
        font-size: 0.88rem;
      }

      #link-list {
        list-style: none;
        padding: 0;
        margin: 14px 0 0;
        border-top: 1px solid var(--line);
      }

      #link-list li {
        margin: 0;
        padding: 14px 0;
        border-bottom: 1px solid var(--line-soft);
      }

      .title {
        font-weight: 600;
        font-size: 0.98rem;
        line-height: 1.3;
      }

      a {
        color: var(--link);
        text-decoration: none;
      }

      a:hover {
        color: var(--link-hover);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .url {
        color: var(--muted);
        font-size: 0.82rem;
        line-height: 1.45;
        margin-top: 5px;
        word-break: break-all;
      }

      .meta {
        color: var(--muted);
        font-size: 0.77rem;
        margin-top: 7px;
      }

      .row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }

      .row .title {
        flex: 1 1 260px;
      }

      @media (max-width: 840px) {
        form {
          grid-template-columns: 1fr;
        }

        form button[type="submit"] {
          width: 100%;
        }
      }

      @media (max-width: 640px) {
        main {
          padding: 24px 16px 34px;
        }

        header {
          margin-bottom: 16px;
        }

        .auth-row {
          align-items: stretch;
        }

        .auth-row .field-group {
          flex-basis: 100%;
        }

        .auth-row button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>{appName}</h1>
        <div class="note">Add, review, and remove saved links. Access is protected.</div>
      </header>

      <section class="auth">
        <div id="auth-status" class="note">Enter admin password to manage links.</div>
        <div class="auth-row" style="margin-top: 10px;">
          <div class="field-group">
            <label for="admin-password">Password</label>
            <input
              id="admin-password"
              type="password"
              placeholder="Admin password"
              autocomplete="current-password"
            />
          </div>
          <button type="button" id="sign-in">Sign in</button>
          <button type="button" id="sign-out" class="button-secondary" hidden>Sign out</button>
        </div>
      </section>

      <section id="admin-ui" hidden>
        <form id="link-form">
          <div class="field">
            <label for="title">Title</label>
            <input id="title" name="title" type="text" placeholder="A clear title" required />
          </div>
          <div class="field">
            <label for="url">URL</label>
            <input id="url" name="url" type="url" placeholder="https://example.com" required />
          </div>
          <button type="submit">Add link</button>
        </form>
        <div class="status" id="status"></div>

        <ul id="link-list">
          <li>Loading...</li>
        </ul>
      </section>
    </main>

    <script
      type="module"
      define:vars={{ apiBase }}
    >
      const authStatus = document.querySelector("#auth-status");
      const passwordInput = document.querySelector("#admin-password");
      const signInButton = document.querySelector("#sign-in");
      const signOutButton = document.querySelector("#sign-out");
      const adminUi = document.querySelector("#admin-ui");
      const list = document.querySelector("#link-list");
      const form = document.querySelector("#link-form");
      const status = document.querySelector("#status");

      const adminUser = "user";
      const storageKey = "laterlist_admin_password";

      const setAuthUi = (hasPassword) => {
        if (hasPassword) {
          authStatus.textContent = "Admin mode unlocked.";
          signOutButton.hidden = false;
          adminUi.hidden = false;
        } else {
          authStatus.textContent = "Enter admin password to manage links.";
          signOutButton.hidden = true;
          adminUi.hidden = true;
        }
      };

      const getPassword = () => sessionStorage.getItem(storageKey) || "";
      const setPassword = (value) => sessionStorage.setItem(storageKey, value);
      const clearPassword = () => sessionStorage.removeItem(storageKey);
      const getAuthHeader = () => {
        const password = getPassword();
        if (!password) return "";
        return `Basic ${btoa(`${adminUser}:${password}`)}`;
      };

      const renderLinks = (items) => {
        if (!items.length) {
          list.innerHTML = "<li>No links yet.</li>";
          return;
        }
        list.innerHTML = items
          .map((item) => {
            const url = item.url ?? item.URL ?? "";
            const title = item.title ?? "";
            const created = item.created_at
              ? new Date(item.created_at).toLocaleString()
              : "";
            const displayTitle = title || url;
            const urlMarkup = title ? `<div class="url">${url}</div>` : "";
            return `
              <li>
                <div class="row">
                  <div class="title">
                    <a href="${url}" target="_blank" rel="noreferrer">${displayTitle}</a>
                  </div>
                  <button data-id="${item.id}" class="button-danger" type="button">Delete</button>
                </div>
                ${urlMarkup}
                <div class="meta">${created}</div>
              </li>
            `;
          })
          .join("");
      };

      const loadLinks = async () => {
        const response = await fetch(`${apiBase}/links`);
        const data = await response.json();
        renderLinks(Array.isArray(data) ? data : []);
      };

      const setupHandlers = () => {
        signInButton.addEventListener("click", async () => {
          const password = String(passwordInput.value || "").trim();
          if (!password) {
            authStatus.textContent = "Password required.";
            return;
          }
          const authHeader = `Basic ${btoa(`${adminUser}:${password}`)}`;
          const response = await fetch(`${apiBase}/admin/check`, {
            method: "GET",
            headers: { Authorization: authHeader },
          });

          if (!response.ok) {
            authStatus.textContent = "Invalid password.";
            return;
          }

          setPassword(password);
          passwordInput.value = "";
          setAuthUi(true);
        });

        signOutButton.addEventListener("click", () => {
          clearPassword();
          setAuthUi(false);
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          status.textContent = "Saving...";
          const formData = new FormData(form);
          const url = formData.get("url");
          const title = String(formData.get("title") ?? "").trim();

          if (!title) {
            status.textContent = "Title is required.";
            return;
          }

          const authHeader = getAuthHeader();
          if (!authHeader) {
            status.textContent = "Admin password required.";
            return;
          }

          const response = await fetch(`${apiBase}/link`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: authHeader,
            },
            body: JSON.stringify({ url, title }),
          });

          if (!response.ok) {
            status.textContent = "Could not save.";
            return;
          }

          status.textContent = "Saved.";
          form.reset();
          await loadLinks();
        });

        list.addEventListener("click", async (event) => {
          const button = event.target.closest("button[data-id]");
          if (!button) return;
          const authHeader = getAuthHeader();
          if (!authHeader) {
            status.textContent = "Admin password required.";
            return;
          }

          const id = button.dataset.id;
          await fetch(`${apiBase}/link/${id}`, {
            method: "DELETE",
            headers: { Authorization: authHeader },
          });
          await loadLinks();
        });
      };

      const init = async () => {
        setAuthUi(Boolean(getPassword()));
        setupHandlers();
        await loadLinks();
      };

      init();
    </script>
  </body>
</html>
